  "widgets": [
    {
      "key": "weather",
      "label": {
        "en": "DMI weather",
        "fr": "Météo DMI",
        "de": "DMI-Wetter",
        "es": "Tiempo DMI"
      },
      "description": {
        "en": "Measured weather, next 24 hours and coming days of a place.",
        "fr": "Temps mesuré, prochaines 24 h et jours à venir d'un lieu.",
        "de": "Gemessenes Wetter, nächste 24 Stunden und kommende Tage eines Orts.",
        "es": "Tiempo medido, próximas 24 horas y próximos días de un lugar."
      },
      "icon": "cloud",
