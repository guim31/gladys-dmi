          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Place or station",
            "fr": "Lieu ou station",
            "de": "Ort oder Station",
            "es": "Lugar o estación"
          }
        },
        {
          "key": "show_chart",
